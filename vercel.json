{
  "crons": [
    { "path": "/api/backup", "schedule": "0 11 * * 1" }
  ],
  "redirects": [
    { "source": "/carbon", "destination": "/", "permanent": true },
    { "source": "/oil", "destination": "/", "permanent": true },
    { "source": "/auction", "destination": "/", "permanent": true },
    { "source": "/forwards", "destination": "/contracts.html", "permanent": true },
    { "source": "/cpi", "destination": "/prices.html", "permanent": true },
    { "source": "/certificates", "destination": "/verify.html", "permanent": true },
    { "source": "/carbon/:slug*", "destination": "/", "permanent": true },
    { "source": "/oil/:slug*", "destination": "/", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=()" }
      ]
    }
  ]
}
